---
// Homepage — tool-first. The hero leads with SEARCH (the thing people came to do),
// then a LIVE embedded calculator so a visitor gets a real answer without navigating.
// Clean look kept; substance restored (v2 was a tool, not a directory of links).
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import SearchBox from '../components/SearchBox';
import HeroWorksheet from '../components/home/HeroWorksheet';
import { getCategories, calculatorRegistry, getCalculatorById } from '../lib/registry';
import { accentFor } from '../lib/categoryAccent';
import { blogPosts } from '../lib/blog';
import { FlaskConical, FileText, ShieldCheck, Lock } from 'lucide-react';
import { SITE_NAME, BASE_URL } from '../config/constants';
import { organizationSchema } from '../lib/jsonld';
import { verification } from '../lib/verification';

const categories = getCategories().filter((cat) => cat.count > 0);
const total = calculatorRegistry.length;


// Trust/Safety band — the Marketplace/Directory pattern's missing section
const trustPoints = [
  { Icon: FlaskConical, title: 'Tested, not guessed', body: `${verification.testCountLabel} automated tests, and ${verification.auditedCount} of ${verification.totalCalculators} calculators checked against independent sources. Deterministic math — never a hallucinated number.`, accent: 'text-accent-emerald-600', ring: 'bg-accent-emerald-500/12' },
  { Icon: FileText, title: 'Shows the work', body: 'Every formula, worked example, and source is on the page — not a black box.', accent: 'text-accent-sky-600', ring: 'bg-accent-sky-500/12' },
  { Icon: ShieldCheck, title: 'Sourced & checkable', body: 'Where a formula has an authoritative source, it’s cited on the page — so you can verify it yourself.', accent: 'text-accent-violet-600', ring: 'bg-accent-violet-500/12' },
  { Icon: Lock, title: 'Private by default', body: 'Runs in your browser. Your inputs never leave your device. No account.', accent: 'text-accent-amber-600', ring: 'bg-accent-amber-500/15' },
];

// Slim, serializable search index for the hero island (no registry in the bundle)
const searchIndex = calculatorRegistry.map((entry) => ({
  t: entry.shortTitle ?? entry.title,
  p: `/${entry.categorySlug}/${entry.id}/`,
  c: entry.category,
  k: entry.seoKeywords,
}));

const popularIds = [
  'bmi-calculator', 'loan-calculator', 'percentage-calculator', 'compound-interest',
  'age-calculator', 'mortgage-amortization-calculator', 'tdee-calculator', 'fraction-calculator',
];
const popular = popularIds.map((id) => getCalculatorById(id)).filter((e) => e !== undefined);

// Quick chips under the search bar — discovery + shows breadth
const quickPicks = ['bmi-calculator', 'loan-calculator', 'percentage-calculator', 'age-calculator']
  .map((id) => getCalculatorById(id))
  .filter((e) => e !== undefined);


const latestPosts = [...blogPosts]
  .sort((a, b) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime())
  .slice(0, 3);

const faqs = [
  { q: 'Are the calculators free?', a: `Yes — all ${total} of them, with no account, no sign-up, and no paywall.` },
  { q: 'Can I trust the results?', a: `Every formula is a tested program, not a language-model guess — backed by ${verification.testCountLabel} automated tests (${verification.auditedCount} of ${verification.totalCalculators} calculators are also checked against independent sources), with the formula and its source shown on each page. The math is deterministic: the same inputs always give the same answer. See how we build and verify calculators on our methodology page.` },
  { q: 'Is my data private?', a: 'Completely. Every calculation runs inside your browser — your numbers are never sent to a server, and nothing is stored about you.' },
  { q: 'Do they work on mobile?', a: 'Yes. Every calculator is fully responsive and loads fast, because pages are static and ship almost no JavaScript.' },
];

const schemas = [
  organizationSchema(),
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    publisher: { '@id': `${BASE_URL}/#organization` },
    name: SITE_NAME,
    url: `${BASE_URL}/`,
    description: `${total}+ free calculators with formulas, worked examples, and expert explanations.`,
    potentialAction: {
      '@type': 'SearchAction',
      target: `${BASE_URL}/search/?q={query}`,
      'query-input': 'required name=query',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  title={`${SITE_NAME} — Free Online Calculators for Finance, Health, Math & More`}
  description={`${total}+ free calculators with formulas, worked examples, and expert explanations. Search or start calculating instantly — no account, and your inputs never leave your browser.`}
  canonicalPath="/"
  schemas={schemas}
>
  <main id="main-content" class="min-h-screen bg-[var(--surface-bg)]">
    {/* ── Hero: the promise, demonstrated ──────────────────────────────
        Left: the pitch and the one primary action (search). Right: a real worked solution the
        visitor can edit (HeroWorksheet). Amber appears once on the page: the highlighter behind
        "show their work". */}
    <section class="hero-grid relative overflow-hidden border-b border-[var(--border-warm)]">
      <div class="max-w-[1200px] mx-auto px-4 md:px-10 pt-14 pb-14 lg:pt-20 lg:pb-20 relative">
        <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">

          <div class="hero-rise">
            <h1 class="hero-title text-[var(--surface-text)] mb-5">
              Calculators that <span class="hero-mark">show their work</span>.
            </h1>
            <p class="text-base md:text-lg text-[var(--surface-text-secondary)] leading-relaxed max-w-xl mb-7">
              Every answer comes with the formula, the steps and the source, so you can check the number instead of just trusting it.
            </p>

            <SearchBox client:idle index={searchIndex} hero />

            <p class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-[var(--surface-text-muted)]">
              <span>Popular:</span>
              {quickPicks.map((c) => (
                <a
                  href={`/${c!.categorySlug}/${c!.id}/`}
                  class="font-medium text-[var(--brand-ink)] underline-offset-4 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--brand-default)] active:opacity-80"
                >
                  {c!.shortTitle ?? c!.title}
                </a>
              ))}
            </p>

            <p class="mt-8 max-w-xl text-sm text-[var(--surface-text-secondary)]">
              <strong class="font-semibold text-[var(--surface-text)]">{verification.auditedCount} of {verification.totalCalculators}</strong> calculators checked against independent sources,
              {verification.testCountLabel} automated tests. Free, private, no account.
            </p>
          </div>

          <div class="hero-rise hero-rise-2">
            <HeroWorksheet client:load />
          </div>
        </div>
      </div>
    </section>

    <div class="max-w-[1200px] mx-auto px-4 md:px-10">

      {/* ── Most used ────────────────────────────────────────────────── */}
      <section aria-label="Popular calculators" class="py-8">
        <h2 class="text-xl font-bold text-[var(--surface-text)] mb-5">Most used</h2>
        <ul class="grid grid-cols-2 md:grid-cols-4 gap-3 list-none p-0">
          {popular.map((calc) => (
            <li>
              <a
                href={`/${calc!.categorySlug}/${calc!.id}/`}
                class="group flex items-start gap-3 h-full p-4 rounded-xl border border-[var(--border-warm)] bg-[var(--surface-card)] shadow-card transition-colors hover:border-[var(--brand-default)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--brand-default)]"
              >
                <span class="mt-0.5 text-[var(--brand-ink)] shrink-0">
                  <CategoryIcon slug={calc!.categorySlug} size={18} />
                </span>
                <span>
                  <span class="block font-semibold text-sm text-[var(--surface-text)]">{calc!.shortTitle ?? calc!.title}</span>
                  <span class="block text-xs text-[var(--surface-text-muted)] mt-0.5">{calc!.category}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      {/* ── Decision tool ────────────────────────────────────────────── */}
      <section aria-label="Decision tool" class="py-4">
        <a
          href="/decisions/can-i-afford-a-house/"
          class="group flex flex-col gap-3 rounded-2xl border border-[var(--border-warm)] bg-[var(--surface-card)] p-6 shadow-card transition-[transform,border-color,box-shadow] duration-200 hover:-translate-y-0.5 hover:border-[var(--brand-default)] hover:shadow-card-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--brand-default)] active:translate-y-0 motion-reduce:transform-none sm:flex-row sm:items-center sm:justify-between"
        >
          <div class="max-w-2xl">
            <p class="text-xs font-semibold uppercase tracking-wide text-[var(--surface-text-muted)]">Decision tool</p>
            <h2 class="mt-1 text-xl font-bold text-[var(--surface-text)]">Can I afford this house?</h2>
            <p class="mt-1 text-[var(--surface-text-secondary)]">One set of numbers, four answers: your monthly payment, debt-to-income, the cash to close, and whether buying beats renting. Save scenarios and share a link.</p>
          </div>
          <span class="shrink-0 rounded-lg bg-[var(--brand-default)] px-5 py-2.5 text-sm font-semibold text-white transition-colors group-hover:bg-[var(--brand-hover)]">Check a house →</span>
        </a>
      </section>

      {/* ── Categories ───────────────────────────────────────────────── */}
      <section id="categories" aria-label="Categories" class="py-8 scroll-mt-20">
        <h2 class="text-xl font-bold text-[var(--surface-text)] mb-5">Browse by category</h2>
        <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 list-none p-0">
          {categories.map((cat) => {
            const a = accentFor(cat.slug);
            return (
            <li>
              <a
                href={`/${cat.slug}/`}
                class={`group flex gap-4 h-full p-5 rounded-xl border border-[var(--border-warm)] bg-[var(--surface-card)] shadow-card transition-[transform,border-color,box-shadow] duration-200 hover:-translate-y-0.5 hover:shadow-card-hover motion-reduce:transform-none motion-reduce:transition-none ${a.border} focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--brand-default)]`}
              >
                <span class={`flex h-11 w-11 shrink-0 items-center justify-center rounded-xl transition-transform duration-200 group-hover:scale-105 motion-reduce:transform-none ${a.tint} ${a.text}`}>
                  <CategoryIcon slug={cat.slug} size={22} />
                </span>
                <span class="min-w-0">
                  <span class="flex items-baseline gap-2">
                    <span class="font-semibold text-[var(--surface-text)]">{cat.name}</span>
                    <span class="font-mono text-tiny text-[var(--surface-text-muted)]">{cat.count}</span>
                  </span>
                  <span class="block text-sm text-[var(--surface-text-secondary)] mt-1 leading-relaxed">{cat.description}</span>
                </span>
              </a>
            </li>
            );
          })}
        </ul>
      </section>

      {/* ── Why trust these calculators (Trust/Safety band) ──────────── */}
      <section aria-label="Why trust these calculators" class="py-8">
        <div class="rounded-2xl border border-[var(--border-warm)] bg-[var(--surface-card)] p-6 sm:p-8">
          <div class="max-w-2xl mb-6">
            <h2 class="text-xl font-bold text-[var(--surface-text)]">Numbers you can actually trust</h2>
            <p class="text-sm text-[var(--surface-text-secondary)] mt-2 leading-relaxed">
              Every result here is a tested program — not a language-model guess. That's the difference between a calculator and asking an AI to "do the math."
            </p>
          </div>
          <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 list-none p-0">
            {trustPoints.map((t) => {
              const Icon = t.Icon;
              return (
              <li class="flex flex-col gap-3">
                <span class={`flex h-10 w-10 items-center justify-center rounded-xl ${t.ring} ${t.accent}`}>
                  <Icon size={20} aria-hidden="true" />
                </span>
                <span class="block font-semibold text-sm text-[var(--surface-text)]">{t.title}</span>
                <span class="block text-sm text-[var(--surface-text-secondary)] leading-relaxed">{t.body}</span>
              </li>
              );
            })}
          </ul>
        </div>
      </section>

      {/* ── Latest guides ────────────────────────────────────────────── */}
      <section aria-label="Latest guides" class="py-8">
        <div class="flex items-baseline justify-between mb-5">
          <h2 class="text-xl font-bold text-[var(--surface-text)]">Latest guides</h2>
          <a href="/blog/" class="text-sm font-medium text-[var(--brand-ink)] hover:underline">All {blogPosts.length} →</a>
        </div>
        <ul class="grid grid-cols-1 md:grid-cols-3 gap-4 list-none p-0">
          {latestPosts.map((post) => (
            <li>
              <a
                href={`/blog/${post.slug}/`}
                class="block h-full p-5 rounded-xl border border-[var(--border-warm)] bg-[var(--surface-card)] shadow-card transition-colors hover:border-[var(--brand-default)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--brand-default)]"
              >
                <p class="text-tiny uppercase tracking-wide text-[var(--surface-text-muted)] mb-1">{post.category} · {post.readingMinutes} min</p>
                <p class="font-semibold text-sm text-[var(--surface-text)] leading-snug">{post.title}</p>
                <p class="text-xs text-[var(--surface-text-secondary)] mt-2 leading-relaxed">{post.excerpt.slice(0, 100)}…</p>
              </a>
            </li>
          ))}
        </ul>
      </section>

      {/* ── FAQ: trust + engagement + SEO ────────────────────────────── */}
      <section aria-label="Frequently asked questions" class="py-8 pb-16 max-w-3xl">
        <h2 class="text-xl font-bold text-[var(--surface-text)] mb-5">Questions, answered</h2>
        <dl class="space-y-4">
          {faqs.map((f) => (
            <div class="rounded-xl border border-[var(--border-warm)] bg-[var(--surface-card)] p-5">
              <dt class="font-semibold text-[var(--surface-text)]">{f.q}</dt>
              <dd class="text-sm text-[var(--surface-text-secondary)] mt-1 leading-relaxed">{f.a}</dd>
            </div>
          ))}
        </dl>
      </section>
    </div>
  </main>
</BaseLayout>

<style>
  /* Graph paper: faint blue grid on the page colour, fading out at the bottom edge */
  .hero-grid {
    background-color: var(--surface-bg);
    background-image:
      linear-gradient(rgba(25, 103, 210, 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(25, 103, 210, 0.07) 1px, transparent 1px);
    background-size: 32px 32px;
  }
  :global(html.dark) .hero-grid {
    background-image:
      linear-gradient(rgba(138, 180, 248, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(138, 180, 248, 0.06) 1px, transparent 1px);
  }

  /* Type scale: the hero is the one big typographic moment */
  .hero-title {
    font-size: clamp(2.25rem, 5.2vw, 3.75rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.06;
  }

  /* The single amber on the page: a highlighter pass behind the thesis */
  .hero-mark {
    background-image: linear-gradient(transparent 58%, rgba(245, 158, 11, 0.5) 58%, rgba(245, 158, 11, 0.5) 92%, transparent 92%);
    padding: 0 0.08em;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  /* Load-in: quiet fade + rise, once */
  .hero-rise {
    animation: hero-rise 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .hero-rise-2 { animation-delay: 0.12s; }
  @keyframes hero-rise {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-rise { animation: none; opacity: 1; transform: none; }
  }
</style>
