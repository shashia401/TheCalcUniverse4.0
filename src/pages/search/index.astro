---
// Search page — noindex (mirrors v2 policy). The island gets a slim prebuilt index.
import BaseLayout from '../../layouts/BaseLayout.astro';
import SearchBox from '../../components/SearchBox';
import CategoryIcon from '../../components/CategoryIcon.astro';
import { calculatorRegistry, getCategories } from '../../lib/registry';
import { accentFor } from '../../lib/categoryAccent';
import { SITE_NAME } from '../../config/constants';

const index = calculatorRegistry.map((entry) => ({
  t: entry.shortTitle ?? entry.title,
  p: `/${entry.categorySlug}/${entry.id}/`,
  c: entry.category,
  k: entry.seoKeywords,
}));

const categories = getCategories().filter((c) => c.count > 0);
---

<BaseLayout
  title={`Search calculators | ${SITE_NAME}`}
  description="Find any of our calculators by name or category."
  canonicalPath="/search/"
  noindex
>
  <main id="main-content" class="min-h-screen bg-[var(--surface-bg)]">
    <div class="max-w-[720px] mx-auto px-4 md:px-8 py-10">
      <nav aria-label="Breadcrumb" class="text-sm text-[var(--surface-text-muted)] mb-6">
        <a href="/" class="text-[var(--brand-ink)] hover:underline">Home</a>
        <span class="mx-2" aria-hidden="true">›</span>
        <span>Search</span>
      </nav>
      <h1 class="text-2xl font-bold text-[var(--surface-text)] mb-2">Search {index.length} calculators</h1>
      <p class="text-sm text-[var(--surface-text-secondary)] mb-6">Type a name, or browse a category below.</p>
      <SearchBox client:load index={index} />

      <section aria-label="Browse by category" class="mt-10">
        <h2 class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--surface-text-muted)] mb-3">Or browse by category</h2>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 list-none p-0">
          {categories.map((cat) => {
            const a = accentFor(cat.slug);
            return (
              <li>
                <a
                  href={`/${cat.slug}/`}
                  class={`flex items-center gap-3 rounded-xl border border-[var(--border-warm)] bg-[var(--surface-card)] p-3 shadow-card transition-[transform,border-color,box-shadow] duration-200 hover:-translate-y-0.5 hover:shadow-card-hover motion-reduce:transform-none motion-reduce:transition-none ${a.border} focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--brand-default)]`}
                >
                  <span class={`flex h-9 w-9 shrink-0 items-center justify-center rounded-lg ${a.tint} ${a.text}`}>
                    <CategoryIcon slug={cat.slug} size={18} />
                  </span>
                  <span class="min-w-0">
                    <span class="block font-semibold text-sm text-[var(--surface-text)]">{cat.name}</span>
                    <span class="block text-tiny text-[var(--surface-text-muted)]">{cat.count} calculators</span>
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    </div>
  </main>
</BaseLayout>
