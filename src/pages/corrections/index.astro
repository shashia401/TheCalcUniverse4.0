---
// Public corrections log. Static HTML, no client JS. Data lives in src/data/corrections.ts.
// Calculator links are built from the registry, so an id that no longer exists is shown unlinked.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCalculatorById } from '../../lib/registry';
import { corrections } from '../../data/corrections';
import { SITE_NAME, BASE_URL } from '../../config/constants';

const linkClass =
  'text-[var(--brand-ink)] underline underline-offset-2 rounded-sm hover:decoration-2 active:opacity-80 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--brand-default)]';

// Dates are plain YYYY-MM-DD; format in UTC so the build machine's timezone never shifts a day.
const monthFmt = new Intl.DateTimeFormat('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const dayFmt = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const at = (d: string) => new Date(`${d}T00:00:00Z`);

const sorted = [...corrections].sort((a, b) => b.date.localeCompare(a.date));

const months: { key: string; label: string; items: typeof sorted }[] = [];
for (const c of sorted) {
  const key = c.date.slice(0, 7);
  let group = months.find((m) => m.key === key);
  if (!group) {
    group = { key, label: monthFmt.format(at(c.date)), items: [] };
    months.push(group);
  }
  group.items.push(c);
}

const href = (c: (typeof sorted)[number]) => {
  if (!c.calculator) return null;
  const entry = getCalculatorById(c.calculator.id);
  return entry ? `/${entry.categorySlug}/${entry.id}/` : null;
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${BASE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Corrections', item: `${BASE_URL}/corrections/` },
  ],
};
---

<BaseLayout
  title={`Corrections Log — Errors We Found and Fixed | ${SITE_NAME}`}
  description={`Every wrong number, label or source we have found and fixed on our calculators, with the date, what was wrong, what it says now, and how we checked it.`}
  canonicalPath="/corrections/"
  schemas={[breadcrumb]}
>
  <main id="main-content" class="min-h-screen bg-[var(--surface-bg)]">
    <div class="max-w-3xl mx-auto px-4 md:px-8 py-14">
      <nav aria-label="Breadcrumb" class="text-sm text-[var(--surface-text-muted)] mb-6">
        <a href="/" class={linkClass}>Home</a>
        <span class="mx-2" aria-hidden="true">›</span>
        <span>Corrections</span>
      </nav>

      <h1 class="text-3xl font-black tracking-tight text-[var(--surface-text)] mb-4">
        Corrections log
      </h1>
      <p class="text-blog text-[var(--surface-text-secondary)] leading-relaxed mb-4 max-w-2xl">
        Every time an audit finds a wrong number, a wrong label or a wrong source on a calculator,
        it is listed here. Each entry gives the date, what was wrong, what the calculator says now,
        and how the fix was checked. Newest entries come first.
      </p>
      <p class="text-base-md text-[var(--surface-text-secondary)] leading-relaxed mb-12 max-w-2xl">
        For how formulas are tested before they ship, see
        {' '}<a href="/methodology/" class={linkClass}>our methodology</a>. If you spot an error that is not
        listed, write to <a href="mailto:contact@thecalcuniverse.com" class={linkClass}>contact@thecalcuniverse.com</a>.
      </p>

      {months.map((m) => (
        <section aria-labelledby={`m-${m.key}`} class="mb-12">
          <h2
            id={`m-${m.key}`}
            class="text-lg font-bold text-[var(--surface-text)] pb-2 mb-2 border-b border-[var(--border-warm)]"
          >
            {m.label}
          </h2>
          <ol class="list-none p-0 m-0">
            {m.items.map((c) => {
              const url = href(c);
              return (
                <li class="py-6 border-b border-[var(--border-warm)] last:border-b-0">
                  <p class="text-sm text-[var(--surface-text-muted)] mb-1">
                    <time datetime={c.date}>{dayFmt.format(at(c.date))}</time>
                    {c.calculator && (
                      <>
                        <span class="mx-2" aria-hidden="true">·</span>
                        {url ? (
                          <a href={url} class={linkClass}>{c.calculator.title}</a>
                        ) : (
                          <span>{c.calculator.title}</span>
                        )}
                      </>
                    )}
                    {!c.calculator && (
                      <>
                        <span class="mx-2" aria-hidden="true">·</span>
                        <span>Site-wide</span>
                      </>
                    )}
                  </p>
                  <p class="text-base-md text-[var(--surface-text)] leading-relaxed">{c.summary}</p>
                  {(c.before || c.after) && (
                    <dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm text-[var(--surface-text-secondary)]">
                      {c.before && (
                        <>
                          <dt class="font-semibold text-[var(--surface-text-muted)]">Was</dt>
                          <dd class="m-0">{c.before}</dd>
                        </>
                      )}
                      {c.after && (
                        <>
                          <dt class="font-semibold text-[var(--surface-text-muted)]">Now</dt>
                          <dd class="m-0">{c.after}</dd>
                        </>
                      )}
                    </dl>
                  )}
                  <p class="mt-3 text-sm text-[var(--surface-text-secondary)] leading-relaxed">
                    <span class="font-semibold text-[var(--surface-text-muted)]">How it was checked. </span>{c.howVerified}
                  </p>
                </li>
              );
            })}
          </ol>
        </section>
      ))}
    </div>
  </main>
</BaseLayout>
