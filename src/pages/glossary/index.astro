---
// Glossary — fully static, grouped by category, with DefinedTerm ItemList schema.
// Upgrade over v2: v2 rendered this client-side and noindexed it. 78 real
// definitions are indexable content — now they're in the HTML and indexed.
import BaseLayout from '../../layouts/BaseLayout.astro';
import GLOSSARY from '../../data/glossary';
import { SITE_NAME, BASE_URL } from '../../config/constants';

const categories = [...new Set(GLOSSARY.map((g) => g.category))];
const grouped = categories.map((cat) => ({
  category: cat,
  items: GLOSSARY.filter((g) => g.category === cat).sort((a, b) => a.term.localeCompare(b.term)),
}));

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Calculator Glossary',
    description: 'Glossary of financial, health, mathematical, engineering, and e-commerce terms.',
    url: `${BASE_URL}/glossary/`,
    numberOfItems: GLOSSARY.length,
    itemListElement: GLOSSARY.map((item, i) => ({
      '@type': 'DefinedTerm',
      position: i + 1,
      name: item.term,
      description: item.definition,
      inCategory: item.category,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${BASE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'Glossary', item: `${BASE_URL}/glossary/` },
    ],
  },
];
---

<BaseLayout
  title={`Calculator Glossary — ${GLOSSARY.length} Terms Defined | ${SITE_NAME}`}
  description="Plain-English definitions of the financial, health, math, engineering, and e-commerce terms used across our calculators — from APR to Z-score."
  canonicalPath="/glossary/"
  schemas={schemas}
>
  <main id="main-content" class="min-h-screen bg-[var(--surface-bg)]">
    <div class="max-w-3xl mx-auto px-4 md:px-8 py-12">
      <nav aria-label="Breadcrumb" class="text-sm text-[var(--surface-text-muted)] mb-6">
        <a href="/" class="text-[var(--brand-ink)] hover:underline">Home</a>
        <span class="mx-2" aria-hidden="true">›</span>
        <span>Glossary</span>
      </nav>

      <h1 class="text-3xl font-black tracking-tight text-[var(--surface-text)] mb-2">Glossary</h1>
      <p class="text-[var(--surface-text-secondary)] mb-8">
        {GLOSSARY.length} terms you'll meet across our calculators, defined in plain English.
      </p>

      <nav aria-label="Glossary categories" class="flex flex-wrap gap-2 mb-10">
        {categories.map((cat) => (
          <a
            href={`#${cat.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
            class="rounded-full border border-[var(--border-warm)] bg-[var(--surface-card)] px-3 py-1 text-sm text-[var(--surface-text-secondary)] transition-colors hover:border-[var(--brand-default)] hover:text-[var(--surface-text)]"
          >
            {cat}
          </a>
        ))}
      </nav>

      {grouped.map(({ category, items }) => (
        <section id={category.toLowerCase().replace(/[^a-z0-9]+/g, '-')} class="mb-12">
          <h2 class="text-xl font-bold text-[var(--surface-text)] mb-4 pb-2 border-b border-[var(--border-warm)]">
            {category}
          </h2>
          <dl class="space-y-5">
            {items.map((item) => (
              <div>
                <dt class="font-semibold text-[var(--surface-text)]">{item.term}</dt>
                <dd class="text-base-md text-[var(--surface-text-secondary)] leading-relaxed">{item.definition}</dd>
              </div>
            ))}
          </dl>
        </section>
      ))}
    </div>
  </main>
</BaseLayout>
