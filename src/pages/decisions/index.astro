---
// Decision tools index: a calculator answers "what is the number"; a decision tool answers "should I".
// The list comes from src/data/decisionTools.ts, so adding a tool there adds it here, to the homepage band,
// to the header/footer links and to the banner on its related calculators.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { decisionTools } from '../../data/decisionTools';
import { BASE_URL } from '../../config/constants';

const path = '/decisions/';
const title = 'Decision Tools: Should I Buy, Borrow or Refinance?';
const description =
  'Free decision tools that answer the real question, not just the number: can I afford it, should I refinance. One form, linked answers, a plain verdict, and a link you can share.';

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${BASE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'Decision tools', item: `${BASE_URL}${path}` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: decisionTools.map((t, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: t.title,
      url: `${BASE_URL}/decisions/${t.slug}/`,
    })),
  },
];
---

<BaseLayout title={title} description={description} canonicalPath={path} schemas={schemas}>
  <main id="main-content" class="min-h-screen bg-[var(--surface-bg)]">
    <div class="max-w-[1200px] mx-auto px-4 md:px-10 py-8">
      <nav aria-label="Breadcrumb" class="text-sm text-[var(--surface-text-muted)] mb-6">
        <a href="/" class="text-[var(--brand-ink)] hover:underline">Home</a>
        <span class="mx-2" aria-hidden="true">›</span>
        <span>Decision tools</span>
      </nav>

      <h1 class="text-2xl md:text-3xl font-bold text-[var(--surface-text)] mb-2">Decision tools</h1>
      <p class="text-[var(--surface-text-secondary)] mb-8 max-w-2xl">
        A calculator gives you a number. These tools answer the question behind it. Enter your situation once and get a plain verdict, the numbers behind it, and a link you can share or come back to.
      </p>

      <ul class="grid gap-5 md:grid-cols-2 list-none p-0">
        {decisionTools.map((t) => (
          <li>
            <a
              href={`/decisions/${t.slug}/`}
              class="group flex h-full flex-col justify-between gap-4 rounded-2xl border border-[var(--border-warm)] bg-[var(--surface-card)] p-6 shadow-card transition-[transform,border-color,box-shadow] duration-200 hover:-translate-y-0.5 hover:border-[var(--brand-default)] hover:shadow-card-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--brand-default)] active:translate-y-0 motion-reduce:transform-none"
            >
              <div>
                <h2 class="text-xl font-bold text-[var(--surface-text)]">{t.title}</h2>
                <p class="mt-2 text-[var(--surface-text-secondary)]">{t.blurb}</p>
              </div>
              <span class="self-start rounded-lg bg-[var(--brand-default)] px-4 py-2 text-sm font-semibold text-white transition-colors group-hover:bg-[var(--brand-hover)]">{t.cta} →</span>
            </a>
          </li>
        ))}
      </ul>

      <section aria-label="How decision tools work" class="mt-14 max-w-3xl">
        <h2 class="text-xl font-bold text-[var(--surface-text)] mb-3">How they work</h2>
        <ul class="space-y-2 text-[var(--surface-text-secondary)] list-disc pl-5">
          <li>They reuse the same tested calculations as the individual calculators, so the numbers match those pages.</li>
          <li>Every assumption is stated on the page, and the verdict rules are guidelines, not lender decisions.</li>
          <li>Everything is calculated in your browser. Saved scenarios stay on your device; the link carries only the numbers you entered.</li>
          <li>See <a class="text-[var(--brand-ink)] underline" href="/methodology/">how we test and verify</a> and the public <a class="text-[var(--brand-ink)] underline" href="/corrections/">corrections log</a>.</li>
        </ul>
      </section>
    </div>
  </main>
</BaseLayout>
