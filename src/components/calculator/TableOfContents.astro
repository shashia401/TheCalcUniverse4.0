---
// "On this page" jump nav (Bankrate/Omni/Inch idea). Static anchor links.
interface Props {
  items: { label: string; href: string }[];
}
const { items } = Astro.props;
---

{items.length > 1 && (
  <nav aria-label="On this page" class="mb-6 rounded-xl border border-[var(--border-warm)] bg-[var(--surface-card)] px-4 py-3">
    <p class="text-tiny font-bold uppercase tracking-[0.16em] text-[var(--surface-text-muted)] mb-2">On this page</p>
    <ul class="flex flex-wrap gap-x-4 gap-y-1.5 list-none p-0 m-0">
      {items.map((item) => (
        <li>
          <a href={item.href} class="text-sm text-[var(--brand-default)] hover:underline">{item.label}</a>
        </li>
      ))}
    </ul>
  </nav>
)}
