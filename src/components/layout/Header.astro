---
// Site header — fully static. The theme toggle is vanilla JS (not a React island),
// so content pages (blog, category, static) whose only island was the toggle now
// ship ZERO framework JS. Calculator pages keep their React island as needed.
import { Search } from 'lucide-react';

const nav = [
  { label: 'Finance', href: '/finance/' },
  { label: 'Health', href: '/health/' },
  { label: 'Math', href: '/math/' },
  { label: 'Everyday', href: '/everyday/' },
  { label: 'Blog', href: '/blog/' },
];
---

<header class="sticky top-0 z-40 border-b border-[var(--border-warm)] bg-[var(--surface-header)] backdrop-blur-md print:hidden">
  <div class="max-w-[1200px] mx-auto px-4 md:px-10 h-14 flex items-center justify-between gap-4">
    <a
      href="/"
      class="flex items-center gap-2.5 shrink-0 rounded-lg focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--brand-default)]"
    >
      <img
        src="/android-chrome-96x96.png"
        alt=""
        width="30"
        height="30"
        class="w-[30px] h-[30px] rounded-[8px] shadow-card"
      />
      <span class="font-black tracking-tight leading-none text-[17px]">
        <span class="text-[var(--surface-text)]">TheCalc</span><span class="text-[var(--accent-rust)]">Universe</span>
      </span>
    </a>

    <nav aria-label="Primary" class="hidden md:flex items-center gap-1">
      {nav.map((item) => (
        <a
          href={item.href}
          class="px-3 py-1.5 rounded-lg text-sm font-medium text-[var(--surface-text-secondary)] transition-colors hover:text-[var(--surface-text)] hover:bg-[var(--surface-card)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--brand-default)]"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a
        href="/search/"
        aria-label="Search calculators"
        class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-[var(--border-warm)] text-[var(--surface-text-muted)] transition-colors hover:text-[var(--surface-text)] hover:border-[var(--brand-default)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--brand-default)]"
      >
        <Search size={16} />
      </a>
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle dark mode"
        class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-[var(--border-warm)] text-[var(--surface-text-muted)] transition-colors hover:text-[var(--surface-text)] hover:border-[var(--brand-default)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--brand-default)] active:opacity-80"
      >
        {/* Moon — shown in light mode (click to go dark) */}
        <svg class="dark:hidden" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
        {/* Sun — shown in dark mode (click to go light) */}
        <svg class="hidden dark:inline" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch (e) {}
  });
</script>
