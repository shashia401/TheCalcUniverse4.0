---
// Base HTML shell for every page. Owns <head>: metadata, canonical, OG, JSON-LD.
// Canonical always equals the served URL (trailing slash) — never a redirecting URL.
import { BASE_URL, SITE_NAME, OG_IMAGE_URL } from '../config/constants';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import '../styles/global.css';
// Defines the --svg-<hex> custom properties (light + dark) used by the 348
// educational diagrams. Without it every diagram fill falls back to black.
import '../styles/svg-theme.css';

interface Props {
  title: string;
  description: string;
  /** Path with leading and trailing slash, e.g. "/finance/loan-calculator/" */
  canonicalPath: string;
  schemas?: Record<string, unknown>[];
  ogType?: string;
  /** Search/utility pages only — excluded from indexing and the sitemap. */
  noindex?: boolean;
}

const { title, description, canonicalPath, schemas = [], ogType = 'website', noindex = false } = Astro.props;
const canonicalUrl = `${BASE_URL}${canonicalPath}`;

// Cap the meta description at ~158 chars on a word boundary — longer descriptions
// just truncate in the SERP. Trims to the last full word, no mid-word cut.
const metaDescription =
  description.length <= 160
    ? description
    : description.slice(0, 158).replace(/\s+\S*$/, '').trimEnd() + '…';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={OG_IMAGE_URL} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={OG_IMAGE_URL} />

    <link rel="preload" href="/fonts/figtree-latin.woff2" as="font" type="font/woff2" crossorigin />

    {/* Apply saved theme before first paint — prevents light/dark flash */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'dark' || (!t && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {}
      })();
    </script>

    {schemas.map((schema) => (
      // Escape "<" so a first-party value containing "</script>" can't break out
      <script type="application/ld+json" is:inline set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
    ))}
  </head>
  <body class="bg-[var(--surface-body)] font-sans antialiased text-[var(--surface-text)]">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:top-2 focus:left-2 focus:bg-[var(--surface-card)] focus:px-4 focus:py-2 focus:rounded-lg focus:shadow-elevation-2"
    >
      Skip to content
    </a>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
