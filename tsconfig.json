{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "resolveJsonModule": true,
    // astro/tsconfigs/strict turns this on, which makes esbuild (dev) keep
    // `import { SomeType }` value-imports of type-only symbols and then fail at
    // runtime ("does not provide an export named …"), breaking island hydration
    // in `astro dev`. Off = esbuild elides type-only imports per binding; the
    // production build is unaffected (rollup tree-shakes either way).
    "verbatimModuleSyntax": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [".astro/types.d.ts", "src/**/*"],
  "exclude": ["node_modules", "dist"]
}
