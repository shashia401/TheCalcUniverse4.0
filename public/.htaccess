  RewriteRule ^date-calculator/?$ /math/date-calculator/ [R=301,L]
  RewriteRule ^decimal-to-fraction-calculator/?$ /math/fraction-to-decimal-calculator/ [R=301,L]
  RewriteRule ^energy-converter/?$ /industrial/energy-converter/ [R=301,L]
  RewriteRule ^factorial-calculator/?$ /math/factorial-calculator/ [R=301,L]
  RewriteRule ^fibonacci-calculator/?$ /math/fibonacci/ [R=301,L]
  RewriteRule ^fraction-calculator/?$ /math/fraction-calculator/ [R=301,L]
  RewriteRule ^fraction-to-decimal-calculator/?$ /math/fraction-to-decimal-calculator/ [R=301,L]
