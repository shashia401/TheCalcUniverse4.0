# TheCalcUniverse — Apache config for shared hosting (Namecheap)

# Custom 404 page
ErrorDocument 404 /404.html

# The sitemap integration emits sitemap-index.xml (robots.txt points crawlers
# there directly), but /sitemap.xml is a common manual/tool-default check —
# alias it internally so both URLs work.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^sitemap\.xml$ /sitemap-index.xml [L]

  # Legacy flat calculator slugs (pre-category-nesting URLs, no known inbound
  # backlinks per Semrush audit) — single-hop 301 to the canonical nested route.
  RewriteRule ^age-calculator/?$ /everyday/age-calculator/ [R=301,L]
  RewriteRule ^area-converter/?$ /industrial/area-converter/ [R=301,L]
  RewriteRule ^average-calculator/?$ /math/average-calculator/ [R=301,L]
  RewriteRule ^basic-calculator/?$ /math/basic-calculator/ [R=301,L]
  RewriteRule ^big-number-calculator/?$ /math/big-number-calculator/ [R=301,L]
  RewriteRule ^binary-calculator/?$ /math/binary-hex-calculator/ [R=301,L]
  RewriteRule ^bmi-calculator/?$ /health/bmi-calculator/ [R=301,L]
  RewriteRule ^business-days-calculator/?$ /math/date-calculator/ [R=301,L]
  RewriteRule ^simplify-fractions-calculator/?$ /math/fraction-calculator/ [R=301,L]
  RewriteRule ^financial/?$ /finance/ [R=301,L]
  RewriteRule ^math-calculators/?$ /math/ [R=301,L]
  RewriteRule ^health-fitness/?$ /health/ [R=301,L]
  RewriteRule ^unit-converter/?$ /industrial/ [R=301,L]
  RewriteRule ^conversion-tools/?$ /industrial/ [R=301,L]
  RewriteRule ^mortgage-calculator/?$ /finance/mortgage-amortization-calculator/ [R=301,L]
  RewriteRule ^body-fat-calculator/?$ /health/body-fat-calculator/ [R=301,L]
  RewriteRule ^calorie-calculator/?$ /health/calorie-calculator/ [R=301,L]
